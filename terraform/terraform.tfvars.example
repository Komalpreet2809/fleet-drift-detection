# Copy this file to terraform.tfvars to configure your environment
aws_region          = "us-east-1"
project_name        = "int333-devops"
environment         = "dev"
enable_aws          = false              # Set to true when deploying on real AWS
instance_type       = "t2.micro"
key_pair_name       = "my-aws-key"
ssh_user            = "ubuntu"
simulated_web_ip    = "192.168.56.10"
simulated_nagios_ip = "192.168.56.20"
