# Managed by Ansible. Do not edit on the server.
server {
    listen 80 default_server;
    server_name _;
    root {{ web_root }};
    index index.html;

    server_tokens off;
    autoindex off;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;

    location / {
        try_files $uri $uri/ =404;
    }
}
