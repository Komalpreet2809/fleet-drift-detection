[Unit]
Description={{ project_title }} - Web Application Service
After=network.target

[Service]
Type=simple
User={{ app_user }}
WorkingDirectory={{ app_directory }}
ExecStart=/usr/bin/python3 {{ app_directory }}/app.py
Restart=always
RestartSec=5
Environment=PORT={{ app_port }}

[Install]
WantedBy=multi-user.target
