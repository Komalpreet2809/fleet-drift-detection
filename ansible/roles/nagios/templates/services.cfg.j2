###############################################################################
# Service Definitions for Web Servers
###############################################################################

{% for host in groups['webservers'] %}
# 1. Host Availability (Ping)
define service {
    use                     generic-service
    host_name               {{ host }}
    service_description     PING Check
    check_command           check-host-alive
    check_interval          {{ check_interval_mins | default(1) }}
    retry_interval          {{ retry_interval_mins | default(1) }}
}

# 2. Standard HTTP Endpoint Check
define service {
    use                     generic-service
    host_name               {{ host }}
    service_description     HTTP Web UI Check
    check_command           check_http_port!{{ hostvars[host]['app_port'] | default(5000) }}!/
    check_interval          {{ check_interval_mins | default(1) }}
    retry_interval          {{ retry_interval_mins | default(1) }}
}

# 3. Custom Python Health API Deep Inspection
define service {
    use                     generic-service
    host_name               {{ host }}
    service_description     Custom API Health & Latency
    check_command           check_webapp_custom!{{ hostvars[host]['app_port'] | default(5000) }}!/health
    check_interval          {{ check_interval_mins | default(1) }}
    retry_interval          {{ retry_interval_mins | default(1) }}
}
{% endfor %}
