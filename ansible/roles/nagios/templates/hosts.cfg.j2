###############################################################################
# Host Definitions (Auto-generated by Ansible from Inventory)
###############################################################################

{% for host in groups['webservers'] %}
define host {
    use                     linux-server
    host_name               {{ host }}
    alias                   Web Application Node {{ host }}
    address                 {{ hostvars[host]['ansible_host'] | default('127.0.0.1') }}
    max_check_attempts      3
    check_period            24x7
    notification_interval   {{ notification_interval_mins | default(10) }}
    notification_period     24x7
}
{% endfor %}
